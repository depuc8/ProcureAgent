# --- Gemini: pick ONE of the two options below ---
# Option A: Google AI Studio API key (quickest; key from https://aistudio.google.com/apikey)
# GOOGLE_API_KEY=your-key-here
# GOOGLE_GENAI_USE_VERTEXAI=FALSE
# Option B: Vertex AI via Application Default Credentials (no key; needs a GCP project with billing)
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# --- Model ---
PROCURE_MODEL=gemini-3.8-flash

# --- Data backends ---
# bigquery | local (local = deterministic in-memory synthetic vendors, no GCP needed)
VENDOR_BACKEND=local
BQ_DATASET=procureagent
BQ_LOCATION=US
BQ_VENDOR_TABLE=vendors
BQ_METRICS_TABLE=request_metrics

# --- Observability ---
# Export spans to Cloud Trace (needs roles/cloudtrace.agent)
OTEL_TO_CLOUD_TRACE=false
# Local JSONL sink for per-request metrics (dashboard falls back to this)
METRICS_JSONL_PATH=logs/request_metrics.jsonl
# Also stream per-request metrics into BigQuery (BQ_METRICS_TABLE)
METRICS_TO_BIGQUERY=false

# --- API (Cloud Run) ---
# Resolved from env first, then Secret Manager secret of the same (lower-kebab) name
# e.g. secret "procure-api-token" -> PROCURE_API_TOKEN
PROCURE_API_TOKEN=
SECRET_MANAGER_ENABLED=false
